# PowerContext Server 配置模板。
#
# 用法：复制为 deploy/powercontext.env（该文件已 gitignore，不会进仓库），
# 替换 __TOKEN__（`scripts/demo.sh` 会自动生成），然后
#   uv run powercontext server run --env-file deploy/powercontext.env --role all
#
# 只有三项被 Recap 读到：SERVER_URL 与 AUTH_TOKEN 由 src/recap/config.py 读取，
# DATABASE_* 决定 PowerContext 把自己的存储放在哪个嵌入式 seekdb 上。
POWERCONTEXT_HOME=__PROJECT_ROOT__/data/powercontext

POWERCONTEXT_SERVER_HTTP_HOST=127.0.0.1
POWERCONTEXT_SERVER_HTTP_PORT=__PORT__
POWERCONTEXT_SERVER_AUTH_ENABLED=true
POWERCONTEXT_SERVER_AUTH_TOKEN=__TOKEN__
POWERCONTEXT_SERVER_ACCESS_MODE=disabled
POWERCONTEXT_SERVER_LOGGING_LEVEL=WARNING
POWERCONTEXT_SERVER_HANDOFF_REPORT_ENABLED=true

# 记忆引擎的持久化后端：同一个 seekdb 内核，只是目录与 Recap 的检索索引分开。
POWERCONTEXT_SERVER_DATABASE_KIND=seekdb
POWERCONTEXT_SERVER_DATABASE_PATH=__PROJECT_ROOT__/data/powercontext/seekdb

POWERCONTEXT_CLIENT_SERVER_URL=http://127.0.0.1:__PORT__
POWERCONTEXT_CLIENT_API_TOKEN=__TOKEN__
POWERCONTEXT_CLIENT_TIMEOUT=30
